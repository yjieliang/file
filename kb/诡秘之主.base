filters:
  and:
    - file.ext == "md"
    - or:
        - note.series == "诡秘之主"
        - note.series == "宿命之环"
properties:
  title:
    displayName: 标题
  type:
    displayName: 分类
  series:
    displayName: 系列
  review:
    displayName: 复核
  supplement:
    displayName: 增补
  source:
    displayName: 来源
  file.name:
    displayName: 文件
  file.mtime:
    displayName: 更新
views:
  - type: table
    name: 全部条目
    order:
      - file.name
      - title
      - type
      - series
      - review
      - file.mtime
    sort:
      - property: type
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: 按分类分组
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - title
      - series
      - review
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 待复核
    filters:
      and:
        - note.review == "待核"
    order:
      - file.name
      - type
      - series
      - review
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: 宿命之环增补
    filters:
      and:
        - note.supplement == "宿命之环"
    order:
      - file.name
      - type
      - series
    sort:
      - property: file.name
        direction: ASC
